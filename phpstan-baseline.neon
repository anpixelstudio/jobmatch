parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property App\\Models\\JobOpening\|Illuminate\\Database\\Eloquent\\Collection\<int, App\\Models\\JobOpening\>\:\:\$criteria_text\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/ChatController.php

		-
			message: '#^Access to an undefined property App\\Models\\Candidate\:\:\$total\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(string\)\: bool\)\|null, Closure\(mixed\)\: \(0\|1\|false\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/UploadController.php

		-
			message: '#^Method App\\Services\\CandidateAnalyzer\:\:requirementMet\(\) has parameter \$criteria with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/CandidateAnalyzer.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: app/Services/CandidateAnalyzer.php

		-
			message: '#^Parameter \#2 \$criteria of method App\\Services\\ResumeMatcher\:\:explainCandidate\(\) expects array\{keywords\: list\<string\>, category\: string\|null, min_years\: int\|null\}, non\-empty\-array\{keywords\?\: list\<string\>, category\?\: string\|null, min_years\?\: int\|null\} given\.$#'
			identifier: argument.type
			count: 2
			path: app/Services/CandidateAnalyzer.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: app/Services/CandidateAnalyzer.php

		-
			message: '#^Method App\\Services\\GeminiClient\:\:writeStructuredReply\(\) has parameter \$criteria with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/GeminiClient.php

		-
			message: '#^Offset 0 on non\-empty\-list\<array\{string, int\<0, max\>\}\|string\> on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Services/GeminiClient.php

		-
			message: '#^Method App\\Services\\ResumeMatcher\:\:buildStructuredReply\(\) has parameter \$criteria with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/ResumeMatcher.php

		-
			message: '#^Method App\\Services\\ResumeMatcher\:\:matchWithCriteria\(\) should return array\{criteria\: array\{keywords\: list\<string\>, category\: string\|null, min_years\: int\|null\}, results\: list\<array\{candidate\: App\\Models\\Candidate, score\: int, reasons\: list\<string\>\}\>\} but returns array\{criteria\: array\{keywords\: list\<string\>, category\: string\|null, min_years\: int\|null\}, results\: array\<int, array\{candidate\: App\\Models\\Candidate, score\: int\<25, max\>, reasons\: list\<string\>\}\>\}\.$#'
			identifier: return.type
			count: 1
			path: app/Services/ResumeMatcher.php

		-
			message: '#^Property App\\Services\\ResumeMatcher\:\:\$skillTerms type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/ResumeMatcher.php
